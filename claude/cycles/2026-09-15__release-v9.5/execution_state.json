      "stories": {
        "ST-01": {"title": "CI-blocking test_changelog_service.py failure on every PR", "classification": "autonomous", "status": "done", "assigned_to": "engine", "github_issue": 1669, "branch": "exec/2026-09-15__release-v9.5/EPIC-01", "commit_sha": "0b5e00ad", "delegation_record_id": null, "blocked_since_utc": null, "unblock_criteria": null, "completed_utc": "2026-09-16T19:45:00Z", "acceptance_verified": true, "spec_references": [], "spec_reference_not_applicable": true, "spec_reference_not_applicable_reason": "Root cause already fixed by commit 58a8d53c (2026-09-14, prior to this cycle's planning) — no new artefact produced this story, verification only.", "deviations_filed": true, "last_completed_substep": "3.1.A.commit", "sign_off_record": null, "notes": "BLG-BE-117/ST-01 was already resolved by commit 58a8d53c ([GOVERNANCE] Fix CI-blocking content assumption in test_changelog_service.py, 2026-09-14) before this cycle's Release Planning even ran — the backlog item was carried into v9.5 scope as a stale duplicate. Re-verified this session: `backend/.venv/bin/python3 -m pytest tests/test_changelog_service.py -v` — 6/6 passed including test_real_changelog_is_parseable; last 10 `CI Pytest Suite` / `Backend Test Coverage Report` runs on main are green (confirmed via `gh run list`). Both ACs satisfied with no code change required this story. Closing as done with evidence rather than fabricating new work against an already-fixed defect, per the ESC-EXEC-20260910-01 honest-disclosure precedent."},
        "ST-02": {"title": "Backend logging output does not conform to structured_logging_standards.md's mandatory JSON Lines format", "classification": "autonomous", "status": "done", "assigned_to": "engine", "github_issue": 1670, "branch": "exec/2026-09-15__release-v9.5/EPIC-01", "commit_sha": "18a86b38", "delegation_record_id": null, "blocked_since_utc": null, "unblock_criteria": null, "completed_utc": "2026-09-16T20:05:00Z", "acceptance_verified": true, "spec_references": ["docs/specs/structured_logging_standards.md#Structured Log Format"], "spec_reference_not_applicable": false, "spec_reference_not_applicable_reason": null, "deviations_filed": true, "last_completed_substep": "3.1.A.commit", "sign_off_record": null, "notes": "Chose path (a) conform code to spec: backend/main.py now installs backend/utils/json_log_formatter.JsonLinesFormatter on the root logger. Confirmed no existing log-based monitoring/alerting depends on the prior plain-text format (no workflow/script parses backend log lines by format; render-si05-log-query.yml's text=si05 substring match still works against the JSON message field). service field revised from its original 5-value enum to the dotted logger name (actual practice — ~35 distinct services/routers modules) via a version bump + changelog entry on structured_logging_standards.md (0.1.1->0.2.0), which also resolves DEV-v9.3-ST03-01. New tests/test_json_log_formatter.py (9 tests) added; full backend suite re-run clean (1495 passed, 10 skipped, 0 failed)."},
        "ST-03": {"title": "Validate limit/offset are non-negative on screener endpoints", "classification": "autonomous", "status": "done", "assigned_to": "engine", "github_issue": 1671, "branch": "exec/2026-09-15__release-v9.5/EPIC-01", "commit_sha": "PENDING", "delegation_record_id": null, "blocked_since_utc": null, "unblock_criteria": null, "completed_utc": "2026-09-16T20:20:00Z", "acceptance_verified": true, "spec_references": [], "spec_reference_not_applicable": true, "spec_reference_not_applicable_reason": "Bug/correctness fix (Case E) — no governing spec beyond the existing screener_api_contract.md, which already defines limit/offset as pagination params without normatively excluding negative values; no new artefact produced.", "deviations_filed": true, "last_completed_substep": "3.1.A.commit", "sign_off_record": null, "notes": "Fixed backend/routers/screener.py GET /screener/results and GET /screener/history: negative limit or offset now returns HTTP 400 INVALID_PARAMS (checked before the existing >200 upper-bound check). Swept all other routers for the same limit/offset param pattern (grep 'limit: int\\|offset: int' across backend/routers/): ai.py and news.py already use FastAPI Query(ge=1, le=...) validation (no gap); backtest_rule_change.py's list_backtest_rule_runs has the same gap (negative limit -> 500 via its broad except-Exception handler) but is out of scope for this story's endpoints — filed as BLG-BE-118 per AC2's 'filed as a follow-up item' option. New tests in tests/test_router_error_envelope_conformance.py (4 cases: negative limit/offset x 2 endpoints). Full backend suite re-run clean: 1499 passed, 10 skipped."},
        "ST-04": {"title": "Consolidate duplicated ATR trailing-stop recalculation logic", "classification": "autonomous", "status": "not_started", "assigned_to": "engine", "github_issue": 1672, "branch": "exec/2026-09-15__release-v9.5/EPIC-01", "commit_sha": null, "delegation_record_id": null, "blocked_since_utc": null, "unblock_criteria": null, "completed_utc": null, "acceptance_verified": false, "spec_references": [], "spec_reference_not_applicable": false, "spec_reference_not_applicable_reason": null, "deviations_filed": false, "last_completed_substep": null, "sign_off_record": null, "notes": ""}
