# Production environment variables — React frontend build
# These are set as env vars on the Render Static Site (production).
# NOT committed with real values — this file is a reference template only.

REACT_APP_API_URL=https://trading-assistant-api-c0f9.onrender.com
REACT_APP_APP_ID=production-app-id
REACT_APP_DEV_FAKE_AUTH=true
REACT_APP_API_KEY=
REACT_APP_ANTHROPIC_API_KEY=
# ST-16 (BLG-OPS-146, EPIC-05, v8.9): added for template parity with
# .env.staging, which sets the same value with the same rationale (overrides
# package.json's "homepage" field so built asset paths resolve at root).
# Production's real env vars live in the Render dashboard, not this repo, and
# were not directly confirmed this session (no dashboard access) -- the
# production site is known to serve correctly today, which is consistent with
# this already being set in the dashboard and this template simply having
# been incomplete relative to it. If the dashboard does NOT already have this
# set, add it there to match; do not assume this file alone changes production.
PUBLIC_URL=/
