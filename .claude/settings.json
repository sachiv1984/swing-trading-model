{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/protect-eslint-config.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/protect-governance-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-commit-format.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/lint-feedback.sh"
          }
        ]
      }
    ]
  }
}
