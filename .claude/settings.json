{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(/tmp/gitleaks detect*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/protect-eslint-config.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/protect-governance-files.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-sealed-artefact.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-commit-format.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-commit-gates.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-pr-merge.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-governance-version-sync.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/lint-feedback.sh"
          },
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/check-state-field-ownership.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/root/swing-trading-model/.claude/hooks/inject-current-state.sh"
          }
        ]
      }
    ]
  }
}
